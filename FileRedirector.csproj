<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FileRedirector</AssemblyName>
    <RootNamespace>FileRedirector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives under this folder; keep its files out of the app build -->
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FileRedirector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.27" />
    <PackageReference Include="Akka.DependencyInjection" Version="1.5.27" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="FluentFTP" Version="54.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
  </ItemGroup>

</Project>
